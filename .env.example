# Paste the https URL ngrok prints in the Colab notebook (no trailing slash)
COLAB_API_BASE=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# Must match API_KEY set in the notebook
COLAB_API_KEY=change-me-please

# Must match MODEL_ID served by vLLM in the notebook
MODEL_ID=epfl-llm/meditron-7b

# ── Model-agnostic backend (defense gateway) ─────────────────────────────────
# The defense pipeline works with any model; these choose which one it protects.
# Known medical models (MedGemma, Meditron, BioMistral, OpenBioLLM, Med42, PMC-LLaMA,
# ClinicalCamel, HuatuoGPT-o1) are detected from the model ID, which sets the template,
# context window and system-role support automatically (src/llm/model_profiles.py).
# Each LLM_* value falls back to the COLAB_* / MODEL_ID / PROMPT_STYLE setting.
#   completions -> /v1/completions, template rendered locally by LLM_TEMPLATE
#   openai_chat -> /v1/chat/completions, server applies the model's chat template
#                  (vLLM, TGI, Ollama, LM Studio, llama.cpp server, OpenAI, ...)
# LLM_PROVIDER=completions
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# gemma | chatml | llama3 | mistral | plain   (only used with LLM_PROVIDER=completions)
# LLM_TEMPLATE=gemma
# Set to 0 if the model's chat template rejects a system role (e.g. Gemma 2)
# LLM_SYSTEM_ROLE=1
# LLM_TEMPERATURE=0.2

# base  -> one-shot primed ChatML, for the un-instruction-tuned epfl-llm/meditron-7b
# chat  -> plain ChatML, for ChatML-formatted instruction-tuned forks of Meditron
# gemma -> <start_of_turn> format, for google/medgemma-4b-it and any Gemma 3 model
PROMPT_STYLE=base

# Meditron-7B is a 2048-token model. MedGemma/Gemma 3 will take 8192 or far more,
# but vLLM sizes the KV cache from this number, so raise it deliberately.
MAX_MODEL_LEN=2048
RESERVE_OUTPUT_TOKENS=384

# Secret for signing session cookies; any long random string
APP_SECRET=change-me-to-something-random

# Comma-separated usernames allowed to use the security administration API
ADMIN_USERNAMES=admin

# ── Defense & Security Pipeline ──────────────────────────────────────────────
# Master switch for the input defense pipeline (1 = enabled, 0 = disabled)
DEFENSE_ENABLED=1

# Hugging Face token: required for Layer A (meta-llama/Llama-Prompt-Guard-2-86M).
# Prompt Guard 2 is a gated model; your HF account must accept the Llama 4
# Community License on its Hugging Face page before downloading.
# If omitted or unavailable, Layer A is gracefully bypassed and Layer B/C protect.
HF_TOKEN=your-huggingface-token-here

# Character limits for inputs
MAX_MESSAGE_CHARS=6000
MAX_PROFILE_FIELD_CHARS=300
