# Paste the https URL ngrok prints in the Colab notebook (no trailing slash)
COLAB_API_BASE=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# Must match API_KEY set in the notebook
COLAB_API_KEY=change-me-please

# Must match MODEL_ID served by vLLM in the notebook
MODEL_ID=epfl-llm/meditron-7b

# base  -> one-shot primed ChatML, for the un-instruction-tuned epfl-llm/meditron-7b
# chat  -> plain ChatML, for ChatML-formatted instruction-tuned forks of Meditron
# gemma -> <start_of_turn> format, for google/medgemma-4b-it and any Gemma 3 model
PROMPT_STYLE=base

# Meditron-7B is a 2048-token model. MedGemma/Gemma 3 will take 8192 or far more,
# but vLLM sizes the KV cache from this number, so raise it deliberately.
MAX_MODEL_LEN=2048
RESERVE_OUTPUT_TOKENS=384

# Secret for signing session cookies; any long random string
APP_SECRET=change-me-to-something-random
