# Copy to .env and adjust. The defaults below run everything locally with Ollama
# (see README "Quick start"). Lines starting with # are optional.

# ── Protected medical model (any OpenAI-compatible endpoint) ─────────────────
#   openai_chat -> /v1/chat/completions, server applies the model's chat template
#                  (Ollama, vLLM, TGI, LM Studio, llama.cpp server, OpenAI, ...)
#   completions -> /v1/completions, template rendered locally by LLM_TEMPLATE
# Known medical models (MedGemma, Meditron, BioMistral, OpenBioLLM, Med42, PMC-LLaMA,
# ClinicalCamel, HuatuoGPT-o1) are detected from the model ID, which sets the template,
# context window and system-role support automatically (src/llm/model_profiles.py).
LLM_PROVIDER=openai_chat
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=hf.co/unsloth/medgemma-4b-it-GGUF:Q4_K_M
MAX_MODEL_LEN=8192
# gemma | chatml | llama3 | mistral | plain   (only used with LLM_PROVIDER=completions)
# LLM_TEMPLATE=gemma
# Attached images are read by a vision model; only its checked text description
# reaches the protected model. Leave unset to use the protected model itself
# (MedGemma reads images). Set for a text-only model, e.g. VISION_MODEL=hf.co/unsloth/medgemma-4b-it-GGUF:Q4_K_M
# VISION_MODEL=
# VISION_BASE_URL=http://localhost:11434
# Set to 0 if the model's chat template rejects a system role (e.g. Gemma 2)
# LLM_SYSTEM_ROLE=1
# LLM_TEMPERATURE=0.2

# ── Layer G and the output guard: Llama Guard on the same Ollama server ──────
# Build the fixed copy once (Ollama's stock template cannot check answers):
#   ollama create llama-guard3-agent:8b -f scripts/ollama/llama-guard3-agent.Modelfile
# Leave both unset to switch Llama Guard off.
GUARD_BASE_URL=http://localhost:11434
GUARD_MODEL=llama-guard3-agent:8b
# GUARD_API_KEY=

# ── Accounts ─────────────────────────────────────────────────────────────────
# Secret for signing login tokens; any long random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8600,http://127.0.0.1:8600
# Usernames with the Admin Console (create the account by signing up with this name)
ADMIN_USERNAMES=admin
# Accounts that may use clinician mode and the evidence explorer. Everyone else
# (including newly registered accounts) is a patient.
CLINICIAN_USERNAMES=

# ── Defense pipeline ─────────────────────────────────────────────────────────
# Master switch for the attack detectors (1 = enabled, 0 = disabled)
DEFENSE_ENABLED=1
# Only needed for gated Hugging Face models (e.g. meta-llama/Llama-Prompt-Guard-2-86M).
# The default Layer A model is ungated, so leave this unset.
# HF_TOKEN=hf_...

# Character limits for inputs
MAX_MESSAGE_CHARS=6000
MAX_PROFILE_FIELD_CHARS=300

# ── Alternative: a model served from Google Colab through ngrok ──────────────
# Leave LLM_* unset and set these instead (see colab/ notebooks).
# COLAB_API_BASE=https://xxxx-xx-xx-xx-xx.ngrok-free.app
# COLAB_API_KEY=change-me-please
# COLAB_JUDGE_BASE=https://yyyy-yy-yy-yy-yy.ngrok-free.app
# MODEL_ID=google/medgemma-4b-it
# PROMPT_STYLE=gemma
# RESERVE_OUTPUT_TOKENS=640
